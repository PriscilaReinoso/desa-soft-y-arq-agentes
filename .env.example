# Variables interpoladas por el docker-compose.yml raíz.
# Copiar este archivo a .env (mismo directorio que el compose) para
# personalizar valores. Si no se definen, rigen los defaults del compose.

# Credenciales de la base de datos compartida (PostgreSQL)
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=nombre de db

# El servicio db publica el puerto 5433 del host (http://localhost:5433)
# para conexiones desde el host, p. ej. DBeaver.

# Configuración del LLM del bot-chat, interpolada por el compose.
# OLLAMA_BASE_URL usa host.docker.internal porque, dentro del contenedor,
# localhost es el propio contenedor y Ollama corre en el host.
# (Para desarrollo local el bot-chat usa su propio bot-chat/.env con
# OLLAMA_BASE_URL=http://localhost:11434.)
LLM_PROVIDER=provider
LLM_MODEL=modelllm
OLLAMA_BASE_URL=host

# Nota: los secretos de la aplicación NO van acá.
# - backend  -> backend/.env  (JWT_SECRET, etc.)
# - bot-chat -> bot-chat/.env (LLM_PROVIDER, LLM_MODEL, GROQ_API_KEY, etc.)