# URL base de la API del backend.
# Solo se exponen variables con prefijo VITE_ (config pública del frontend).
# En el Dockerfile se pasa como build-arg: --build-arg VITE_API_BASE_URL=...
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# URL base del bot-agent (asistente IA).
# En el Dockerfile se pasa como build-arg: --build-arg VITE_CHAT_API_BASE_URL=...
VITE_CHAT_API_BASE_URL=http://127.0.0.1:8001
